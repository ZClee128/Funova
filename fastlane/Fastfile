default_platform(:ios)

platform :ios do
  # =========================================================
  # 方式 A：直接上传仓库里已编译好的 IPA（当前即可用）
  # 经核验，该 IPA 已用 App Store 分发证书签名
  # （get-task-allow: false、无设备列表、bundle id 一致），
  # 因此无需重新签名，可直接上传到 App Store Connect。
  # 前置条件：App Store Connect API Key 已配置为仓库 Secrets。
  # =========================================================
  desc "Upload the prebuilt IPA to App Store Connect and submit for review"
  lane :upload_ipa do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APPSTORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APPSTORE_CONNECT_API_KEY_P8"],
      duration: 1200,
      in_house: false
    )

    # 审核回复文案（贴进 App Review Information → Notes），用于 Guideline 2.1 等“需补资料”场景
    notes = nil
    notes_file = ENV["APP_REVIEW_NOTES_FILE"] || "APP_REVIEW_NOTES.txt"
    if File.exist?(notes_file)
      notes = File.read(notes_file).strip
    end
    # 录屏附件（App Review Attachment，审核员可见）；留空则不附视频
    attachment = ENV["APP_REVIEW_ATTACHMENT"]
    attachment = nil unless attachment && File.exist?(attachment)

    # 先把回复文案+录屏写进 App Review Information（必须在 submit 之前）
    apply_review_info

    deliver(
      api_key: api_key,
      app_identifier: "com.mmhua.com",
      team_id: "S88VU4PBFB",
      ipa: "Snipra-iOSreview-20260921.ipa",
      skip_metadata: true,     # 元数据（名称/描述/截图等）需先在 App Store Connect 后台填好
      skip_screenshots: true,
      submit_for_review: true, # 上传后直接提审；若后台元数据不齐会失败，属正常校验
      automatic_release: false,
      # API Key 认证暂不支持内购预检，必须显式关闭，否则 deliver 直接报错
      precheck_include_in_app_purchases: false,
      # 审核回复备注（被拒后补资料用）
      app_review_information: {
        notes: notes,
        demo_account_required: false
      },
      # 录屏附件（可选；提供后作为 App Review Attachment 给审核员看）
      app_review_attachment_file: attachment,
      # 出口合规声明：标准 App（仅用 HTTPS 等常规加密，属豁免类）填 false
      submission_information: {
        export_compliance_uses_encryption: false
      },
      force: true
    )
  end

  # =========================================================
  # 方式 B：若后续把 Xcode 源码加入仓库，则从源码打包再上传
  # 前置条件：仓库 Secrets 里放好分发证书与分发 profile
  #   DIST_CERT_P12 (base64) / DIST_CERT_PASSWORD / DIST_PROVISIONING_PROFILE (base64)
  # 也可用 fastlane match 统一管理证书（推荐）。
  # =========================================================
  # =========================================================
  # 方式 A2：IPA 已传过（构建号被占用），直接提交已上传的构建
  # 适用于“IPA 是现成编译包、构建号固定”的场景——避免重复上传被拒
  # =========================================================
  desc "Submit an already-uploaded build for review without re-uploading the binary"
  lane :submit_existing_build do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APPSTORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APPSTORE_CONNECT_API_KEY_P8"],
      duration: 1200,
      in_house: false
    )

    # 同样带上审核回复文案与录屏附件（被拒后补资料用）
    notes = nil
    notes_file = ENV["APP_REVIEW_NOTES_FILE"] || "APP_REVIEW_NOTES.txt"
    if File.exist?(notes_file)
      notes = File.read(notes_file).strip
    end
    attachment = ENV["APP_REVIEW_ATTACHMENT"]
    attachment = nil unless attachment && File.exist?(attachment)

    # 先把回复文案+录屏写进 App Review Information（必须在 submit 之前）
    apply_review_info

    deliver(
      api_key: api_key,
      app_identifier: "com.mmhua.com",
      team_id: "S88VU4PBFB",
      build_number: ENV["APP_BUILD_NUMBER"] || "6",  # 已上传的构建号，提交它而非重传
      skip_binary_upload: true,     # 不重传二进制，只提交已上传的构建
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      # 审核回复备注（贴进 App Review Information → Notes）
      app_review_information: {
        notes: notes,
        demo_account_required: false
      },
      # 录屏附件（App Review Attachment，审核员可见）
      app_review_attachment_file: attachment,
      # 出口合规声明：标准 App（仅用 HTTPS 等常规加密，属豁免类）填 false
      submission_information: {
        export_compliance_uses_encryption: false
      },
      force: true
    )
  end

  # =========================================================
  # 方式 A3：被拒后补资料重提（Guideline 2.1 等“需补充信息”类）
  # 不重传二进制，只把“审核备注 + 录屏附件”提交并重新提审。
  # 用法（本地或 Actions 手动触发）：
  #   APP_REVIEW_NOTES_FILE=APP_REVIEW_NOTES.txt APP_REVIEW_ATTACHMENT=/path/to/recording.mov fastlane ios resubmit_with_info
  # 说明：
  #   - notes 从 APP_REVIEW_NOTES_FILE 读取（纯文本，会贴进 App Review Information 的 Notes）
  #   - 录屏附件从 APP_REVIEW_ATTACHMENT 读取（.mov/.mp4，作为 App Review Attachment 给审核员看）
  #   - 若附件路径为空，则只提交文字备注、不附视频
  # =========================================================
  desc "Resubmit an already-uploaded build with App Review notes + screen-recording attachment"
  lane :resubmit_with_info do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APPSTORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APPSTORE_CONNECT_API_KEY_P8"],
      duration: 1200,
      in_house: false
    )

    notes = nil
    notes_file = ENV["APP_REVIEW_NOTES_FILE"]
    if notes_file && File.exist?(notes_file)
      notes = File.read(notes_file).strip
    end

    attachment = ENV["APP_REVIEW_ATTACHMENT"]
    attachment = nil unless attachment && File.exist?(attachment)

    # 先把回复文案+录屏写进 App Review Information（必须在 submit 之前）
    apply_review_info

    deliver(
      api_key: api_key,
      app_identifier: "com.mmhua.com",
      team_id: "S88VU4PBFB",
      build_number: ENV["APP_BUILD_NUMBER"] || "6",  # 已上传的构建号（改名后为 6）
      skip_binary_upload: true,     # 不重传二进制，只补资料 + 重提
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      # 审核备注（贴进 App Review Information → Notes）
      app_review_information: {
        notes: notes,
        demo_account_required: false
      },
      # 录屏附件（App Review Attachment，审核员可见）
      app_review_attachment_file: attachment,
      # 出口合规声明
      submission_information: {
        export_compliance_uses_encryption: false
      },
      force: true
    )
  end

  # =========================================================
  # 审核回复：直接写 App Review Information 的 Notes + 附件
  # 关键：deliver 在 skip_metadata: true 时会直接 return，
  # 不会写入审核备注/附件（已在 fastlane 源码确认）。
  # 因此这里用 App Store Connect API 直接写，既保证回复送达，
  # 又不触碰其它元数据（名称/描述/截图等）。
  # 必须在 deliver（含 submit_for_review）之前调用，
  # 这样提审时审核员就能看到备注与录屏。
  # =========================================================
  desc "Set App Review Information notes + attachment via App Store Connect API"
  lane :apply_review_info do
    require 'spaceship'
    app_store_connect_api_key(
      key_id: ENV["APPSTORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APPSTORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APPSTORE_CONNECT_API_KEY_P8"],
      duration: 1200,
      in_house: false
    )

    notes = nil
    notes_file = ENV["APP_REVIEW_NOTES_FILE"] || "APP_REVIEW_NOTES.txt"
    notes = File.read(notes_file).strip if File.exist?(notes_file)
    attachment = ENV["APP_REVIEW_ATTACHMENT"]
    attachment = nil unless attachment && File.exist?(attachment)

    begin
      app = Spaceship::ConnectAPI::App.find("com.mmhua.com")
      version_string = ENV["APP_VERSION_STRING"] || "0.1.13"
      versions = begin
        app.get_app_store_versions
      rescue
        Spaceship::ConnectAPI::AppStoreVersion.all(filter: { app: app.id })
      end
      version = versions.find { |v| v.version_string == version_string && v.platform.to_s == "IOS" }
      UI.user_error!("App Store Connect 上找不到版本 #{version_string}") unless version

      detail = version.fetch_app_store_review_detail rescue nil
      if detail
        detail.update(attributes: { notes: notes })
      else
        detail = version.create_app_store_review_detail(attributes: { notes: notes })
      end
      UI.success("已写入 App Review Information 备注（Notes）")

      if attachment
        detail ||= version.fetch_app_store_review_detail
        detail.upload_attachment(path: attachment)
        UI.success("已上传审核附件：#{attachment}")
      end
    rescue => ex
      UI.important("设置审核回复信息失败（不影响二进制上传与提审）：#{ex.message}")
    end
  end

  desc "Build from source (Xcode project) then upload & submit"
  lane :build_and_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APPSTORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APPSTORE_CONNECT_API_KEY_P8"],
      duration: 1200,
      in_house: false
    )

    setup_ci if ENV["CI"]

    # 方式 1：直接安装 Secrets 中的分发证书与 profile
    # install_certificate(
    #   certificate_path: "fastlane/certs/dist.p12",
    #   certificate_password: ENV["DIST_CERT_PASSWORD"]
    # )
    # 方式 2（推荐）：用 match 从私有仓库拉取证书
    # match(type: "appstore", readonly: true)

    gym(
      scheme: "Pro91",          # 替换为你的 Xcode scheme
      export_method: "app-store",
      output_directory: "build",
      output_name: "Funova-A-iOS.ipa"
    )

    deliver(
      api_key: api_key,
      app_identifier: "com.mmhua.com",
      team_id: "S88VU4PBFB",
      ipa: "build/Funova-A-iOS.ipa",
      submit_for_review: true,
      automatic_release: false,
      # 出口合规声明：标准 App（仅用 HTTPS 等常规加密，属豁免类）填 false
      submission_information: {
        export_compliance_uses_encryption: false
      },
      force: true
    )
  end
end
